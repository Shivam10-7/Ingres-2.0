{
  "table": "ingresdata2025",

  "dimensions": {
    "_state": {
      "type": "geography",
      "level": "state"
    },
    "district": {
      "type": "geography",
      "level": "district"
    },
    "assessment_unit_name": {
      "type": "geography",
      "level": "block"
    },
    "assessment_unit_type": {
      "type": "classification"
    },
    "categorization": {
      "type": "status",
      "allowed_values": [
        "safe",
        "semi-critical",
        "critical",
        "over-exploited",
        "saline"
      ]
    }
  },

  "measures": {
    "total_area_of_assessment_unit_(ha)": {
      "category": "area",
      "unit": "ha"
    },
    "recharge_worthy_area(ha)": {
      "category": "area",
      "unit": "ha"
    },

    "recharge_from_rainfall-monsoon_season": {
      "category": "recharge",
      "unit": "ham",
      "season": "monsoon"
    },
    "recharge_from_other_sources-_monsoon_season": {
      "category": "recharge",
      "unit": "ham",
      "season": "monsoon"
    },
    "recharge_from_rainfall-non_monsoon_season": {
      "category": "recharge",
      "unit": "ham",
      "season": "non-monsoon"
    },
    "recharge_from_other_sources-_non_monsoon_season": {
      "category": "recharge",
      "unit": "ham",
      "season": "non-monsoon"
    },

    "total_annual_ground_water_(ham)_recharge": {
      "category": "recharge",
      "unit": "ham",
      "is_total": true,
      "components": [
        "recharge_from_rainfall-monsoon_season",
        "recharge_from_other_sources-_monsoon_season",
        "recharge_from_rainfall-non_monsoon_season",
        "recharge_from_other_sources-_non_monsoon_season"
      ]
    },

    "total_natural_discharges_(ham)": {
      "category": "loss",
      "unit": "ham"
    },

    "annual_extractable_ground_water_resource_(ham)": {
      "category": "availability",
      "unit": "ham",
      "derived_from": [
        "total_annual_ground_water_(ham)_recharge",
        "total_natural_discharges_(ham)"
      ]
    },

    "ground_water_extraction_for_irrigation_use_(ham)": {
      "category": "extraction",
      "unit": "ham",
      "type": "irrigation"
    },
    "ground_water_extraction_for_industrial_use_(ham)": {
      "category": "extraction",
      "unit": "ham",
      "type": "industrial"
    },
    "ground_water_extraction_for_domestic_use_(ham)": {
      "category": "extraction",
      "unit": "ham",
      "type": "domestic"
    },

    "total_extraction_(ham)": {
      "category": "extraction",
      "unit": "ham",
      "is_total": true,
      "components": [
        "ground_water_extraction_for_irrigation_use_(ham)",
        "ground_water_extraction_for_industrial_use_(ham)",
        "ground_water_extraction_for_domestic_use_(ham)"
      ]
    },

    "annual_gw_allocation_for_domestic_use_as_on_2025_(ham)": {
      "category": "planning",
      "unit": "ham"
    },

    "net_ground_water_availability_for_future_use_(ham)": {
      "category": "availability",
      "unit": "ham"
    },

    "stage_of_ground_water_extraction_(%)": {
      "category": "ratio",
      "unit": "percent",
      "is_derived": true,
      "formula": "total extraction / annual extractable resource"
    }
  },

  "relationships": {
    "no_mixing_rules": [
      {
        "total": "total_extraction_(ham)",
        "components": [
          "ground_water_extraction_for_irrigation_use_(ham)",
          "ground_water_extraction_for_industrial_use_(ham)",
          "ground_water_extraction_for_domestic_use_(ham)"
        ]
      },
      {
        "total": "total_annual_ground_water_(ham)_recharge",
        "components": [
          "recharge_from_rainfall-monsoon_season",
          "recharge_from_other_sources-_monsoon_season",
          "recharge_from_rainfall-non_monsoon_season",
          "recharge_from_other_sources-_non_monsoon_season"
        ]
      }
    ]
  },

  "units": {
    "ham": ["recharge", "extraction", "availability"],
    "ha": ["area"],
    "percent": ["ratio"]
  }
}