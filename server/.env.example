# MongoDB connection string (e.g. mongodb://user:pass@host:port/dbname)
MONGO_URI=

# Secret used to sign JWT tokens
JWT_SECRET=

# URL of the client app (used by CORS). Change when deploying.
CLIENT_URL=http://localhost:5173

# Other environment variables already in use by the project:
DB_HOST=
DB_USER=
DB_NAME=
DB_PASSWORD=
